{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  },
  "productName": "Warpcore Visual Builder",
  "mainBinaryName": "Warpcore Visual Builder",
  "version": "1.0.0",
  "identifier": "com.warpcore.visual-builder",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "fullscreen": false,
        "resizable": true,
        "title": "Warpcore Visual Builder",
        "width": 1400,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 700,
        "useHttpsScheme": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  }
}
